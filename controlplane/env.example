# HTTP
CP_HTTP_ADDR=:8080

# Postgres (job store control plane)
CP_DATABASE_URL=postgres://controlplane:controlplane@localhost:5432/controlplane?sslmode=disable

# Meltano
CP_MELTANO_BIN=meltano
CP_TENANTS_ROOT=/srv/tenants
CP_SYSTEM_DB_URI=postgres://meltano:meltano@localhost:5432/meltano_system?sslmode=disable

# Eksekusi
CP_WORKER_CONCURRENCY=2
CP_JOB_TIMEOUT_SECONDS=3600
CP_HEARTBEAT_SECONDS=10
CP_LEASE_SECONDS=300
CP_LOG_TAIL_LINES=100

# Logging: debug|info|warn|error
CP_LOG_LEVEL=info
