# HTTP
CP_HTTP_ADDR=:8080

# File .env yang dibaca saat start (default: .env di direktori kerja)
CP_ENV_FILE=.env

# Postgres (job store control plane)
# Nilai "memory://" memakai store in-memory (demo satu proses, tanpa database).
CP_DATABASE_URL=postgres://controlplane:controlplane@localhost:5432/controlplane?sslmode=disable
# Jalankan migrations/*.sql saat start (false bila migrasi dikelola terpisah)
CP_AUTO_MIGRATE=true

# Meltano
CP_MELTANO_BIN=meltano
CP_TENANTS_ROOT=/srv/tenants
CP_SYSTEM_DB_URI=postgres://meltano:meltano@localhost:5432/meltano_system?sslmode=disable

# Eksekusi
CP_WORKER_CONCURRENCY=2
CP_JOB_TIMEOUT_SECONDS=3600
CP_HEARTBEAT_SECONDS=10
CP_LEASE_SECONDS=300
CP_LOG_TAIL_LINES=100

# Logging: debug|info|warn|error
CP_LOG_LEVEL=info

# Local/demo only. Stores connection passwords in the control-plane database.
# Keep false in production and use secret_ref with Vault/AWS/etc.
CP_ALLOW_PLAINTEXT_SECRETS=false
