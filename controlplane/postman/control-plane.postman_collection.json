    {
      "name": "3 - Connectors",
      "item": [
        {
          "name": "List connectors (katalog)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/connectors", "host": ["{{baseUrl}}"], "path": ["v1", "connectors"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('source = catalog', function () { pm.expect(j.source).to.eql('catalog'); });",
                  "pm.test('katalog tidak kosong', function () { pm.expect(j.data.length).to.be.above(0); });",
                  "const c = j.data[0];",
                  "pm.test('field konektor lengkap', function () { pm.expect(c).to.have.property('name'); pm.expect(c).to.have.property('kind'); pm.expect(c).to.have.property('driver'); });",
                  "console.log('connector pertama = ' + c.name + ' (' + c.kind + '/' + c.driver + ')');"
                ]
              }
            }
          ]
        },
        {
          "name": "List connectors - filter kind + driver",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/connectors?kind=extractor&driver={{connectorDriver}}", "host": ["{{baseUrl}}"], "path": ["v1", "connectors"], "query": [{ "key": "kind", "value": "extractor" }, { "key": "driver", "value": "{{connectorDriver}}" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('hanya extractor', function () { j.data.forEach(function (c) { pm.expect(c.kind).to.eql('extractor'); }); });",
                  "pm.test('hanya driver yang diminta', function () { j.data.forEach(function (c) { pm.expect(c.driver).to.eql(pm.collectionVariables.get('connectorDriver')); }); });",
                  "if (j.data.length > 0) { pm.collectionVariables.set('extractorName', j.data[0].name); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List connectors - filter loader",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/connectors?kind=loader&driver={{connectorDriver}}", "host": ["{{baseUrl}}"], "path": ["v1", "connectors"], "query": [{ "key": "kind", "value": "loader" }, { "key": "driver", "value": "{{connectorDriver}}" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('hanya loader', function () { j.data.forEach(function (c) { pm.expect(c.kind).to.eql('loader'); }); });",
                  "if (j.data.length > 0) { pm.collectionVariables.set('loaderName', j.data[0].name); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List connectors - tenant (butuh project Meltano)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/connectors?tenant_id={{tenantId}}", "host": ["{{baseUrl}}"], "path": ["v1", "connectors"], "query": [{ "key": "tenant_id", "value": "{{tenantId}}" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 saat project Meltano tenant siap; 422/500 saat belum', function () {",
                  "    pm.expect([200, 422, 500]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const j = pm.response.json();",
                  "    pm.test('source = tenant', function () { pm.expect(j.source).to.eql('tenant'); });",
