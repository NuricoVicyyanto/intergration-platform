    {
      "name": "4 - Pipeline",
      "item": [
        {
          "name": "Create pipeline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"name\": \"orders-sync\",\n  \"extractor\": \"{{extractorName}}\",\n  \"loader\": \"{{loaderName}}\",\n  \"source_connection_id\": \"{{sourceConnectionId}}\",\n  \"destination_connection_id\": \"{{destinationConnectionId}}\",\n  \"default_timeout_seconds\": 3600,\n  \"max_attempts\": 3,\n  \"source_filter\": {\n    \"streams\": [],\n    \"row_filter\": \"\"\n  },\n  \"transfer_options\": {\n    \"batch_size_rows\": 50000,\n    \"validate_records\": false,\n    \"load_method\": \"\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/pipelines", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('source_filter persisted', function () { pm.expect(pm.response.json().source_filter).to.have.property('streams'); });",
                  "pm.test('transfer_options persisted', function () { pm.expect(pm.response.json().transfer_options).to.have.property('batch_size_rows'); });",
                  "pm.collectionVariables.set('pipelineId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate pipeline (tanpa eksekusi)",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}/validate", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}", "validate"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "console.log('resolved_state_id = ' + pm.response.json().resolved_state_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get pipeline",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Update pipeline",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"orders-sync-reviewed\",\n  \"enabled\": true,\n  \"default_timeout_seconds\": 5400,\n  \"max_attempts\": 3,\n  \"state_id_suffix\": \"reviewed\",\n  \"source_filter\": {\n    \"streams\": [],\n    \"row_filter\": \"\"\n  },\n  \"transfer_options\": {\n    \"batch_size_rows\": 50000,\n    \"validate_records\": false,\n    \"load_method\": \"\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('pipeline diperbarui', function () { pm.expect(pm.response.json().name).to.eql('orders-sync-reviewed'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List pipelines",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/pipelines?tenant_id={{tenantId}}", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines"], "query": [{ "key": "tenant_id", "value": "{{tenantId}}" }] } },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Run",
      "item": [
        {
          "name": "Start run",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeout_seconds\": 3600,\n  \"full_refresh\": false,\n  \"trigger\": \"postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}/runs", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}", "runs"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "pm.collectionVariables.set('runId', pm.response.json().id);",
                  "console.log('runId = ' + pm.collectionVariables.get('runId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get run",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs/{{runId}}", "host": ["{{baseUrl}}"], "path": ["v1", "runs", "{{runId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "console.log('status = ' + pm.response.json().status + ' exit_code = ' + pm.response.json().exit_code);"
                ]
              }
            }
          ]
        },
        {
          "name": "List runs",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs?pipeline_id={{pipelineId}}&limit=50", "host": ["{{baseUrl}}"], "path": ["v1", "runs"], "query": [{ "key": "pipeline_id", "value": "{{pipelineId}}" }, { "key": "limit", "value": "50" }] } },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "List runs - filter status",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs?status=queued&status=running", "host": ["{{baseUrl}}"], "path": ["v1", "runs"], "query": [{ "key": "status", "value": "queued" }, { "key": "status", "value": "running" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('semua status aktif', function () { pm.response.json().data.forEach(function (r) { pm.expect(['queued', 'running', 'cancelling']).to.include(r.status); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List runs - status tidak dikenal (harus 422)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs?status=selesai", "host": ["{{baseUrl}}"], "path": ["v1", "runs"], "query": [{ "key": "status", "value": "selesai" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('422 Unprocessable Entity', function () { pm.response.to.have.status(422); });"]
              }
            }
          ]
        },
        {
          "name": "List run events",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs/{{runId}}/events", "host": ["{{baseUrl}}"], "path": ["v1", "runs", "{{runId}}", "events"] } },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Get run logs and progress",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/runs/{{runId}}/logs?limit=200", "host": ["{{baseUrl}}"], "path": ["v1", "runs", "{{runId}}", "logs"], "query": [{ "key": "limit", "value": "200" }] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('summary contains execution stage', function () { pm.expect(j.summary).to.have.property('stage'); pm.expect(j.summary).to.have.property('progress_percent'); });",
                  "pm.test('log lines are returned as an array', function () { pm.expect(j.log.lines).to.be.an('array'); });",
                  "console.log('execution stage = ' + j.summary.stage + ', lines = ' + j.log.line_count);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run kedua saat run pertama masih aktif (harus 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"timeout_seconds\": 3600\n}" },
            "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}/runs", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}", "runs"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict karena sudah ada run aktif', function () { pm.response.to.have.status(409); });",
                  "pm.test('problem+json', function () { pm.response.to.have.header('Content-Type', 'application/problem+json'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6 - Cancel, Retry & Cleanup",
      "item": [
        {
          "name": "Cancel run",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/runs/{{runId}}/cancel", "host": ["{{baseUrl}}"], "path": ["v1", "runs", "{{runId}}", "cancel"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "console.log('status setelah cancel = ' + pm.response.json().status);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry run",
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }],
            "url": { "raw": "{{baseUrl}}/v1/runs/{{runId}}/retry", "host": ["{{baseUrl}}"], "path": ["v1", "runs", "{{runId}}", "retry"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted (run baru) atau 409 bila run belum terminal', function () {",
                  "    pm.expect([202, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 202) {",
                  "    const j = pm.response.json();",
                  "    pm.collectionVariables.set('runId', j.id);",
                  "    console.log('run baru = ' + j.id + ' retried_from = ' + j.retried_from);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete pipeline",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/pipelines/{{pipelineId}}", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{pipelineId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', function () { pm.response.to.have.status(204); });",
                  "pm.test('body kosong', function () { pm.expect(pm.response.text()).to.eql(''); });",
                  "pm.collectionVariables.set('deletedPipelineId', pm.collectionVariables.get('pipelineId'));",
                  "pm.collectionVariables.set('pipelineId', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get pipeline setelah delete (harus 404)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/pipelines/{{deletedPipelineId}}", "host": ["{{baseUrl}}"], "path": ["v1", "pipelines", "{{deletedPipelineId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]
              }
            }
          ]
        },
        {
          "name": "Delete source connection",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/connections/{{sourceConnectionId}}", "host": ["{{baseUrl}}"], "path": ["v1", "connections", "{{sourceConnectionId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]
              }
            }
          ]
        },
        {
          "name": "Delete destination connection",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/connections/{{destinationConnectionId}}", "host": ["{{baseUrl}}"], "path": ["v1", "connections", "{{destinationConnectionId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]
              }
            }
          ]
        },
        {
          "name": "Delete tenant",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}", "host": ["{{baseUrl}}"], "path": ["v1", "tenants", "{{tenantId}}"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]
              }
            }
          ]
        }
      ]
    }
  ]
