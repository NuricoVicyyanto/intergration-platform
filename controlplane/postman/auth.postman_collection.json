{
  "info": {
    "_postman_id": "ad5b926f-876c-4ba8-bc3d-63f5a5686358",
    "name": "Control Plane Authentication",
    "description": "Login contract and role checks for the control plane dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "superadminUsername",
      "value": "superadmin"
    },
    {
      "key": "superadminPassword",
      "value": "SuperAdmin!2026-Meltano"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{superadminUsername}}\",\n  \"password\": \"{{superadminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeds', () => pm.response.to.have.status(200));",
              "pm.test('role is superadmin', () => pm.expect(pm.response.json().user.role).to.eql('superadmin'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('session is active', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('superadmin can list users', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logout succeeds', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
