# Salin file ini menjadi .env.docker, lalu isi kredensial database eksternal.
#
# Control plane dan Meltano memakai database yang berbeda. Jangan arahkan
# keduanya ke database yang sama karena keduanya memiliki tabel "runs".
CP_DATABASE_URL=postgres://controlplane:CHANGE_ME@host.docker.internal:5432/controlplane?sslmode=disable
CP_SYSTEM_DB_URI=postgres://meltano:CHANGE_ME@host.docker.internal:5432/meltano_system?sslmode=disable

# Tenant yang diprovision otomatis pada docker compose up pertama.
CP_BOOTSTRAP_TENANT=acme
CP_BOOTSTRAP_ENVIRONMENT=dev
# Default aplikasi adalah true. Set false untuk hanya dua connector awal.
CP_BOOTSTRAP_INSTALL_ALL_CONNECTORS=true
CP_BOOTSTRAP_EXTRACTOR=tap-postgres
CP_BOOTSTRAP_LOADER=target-postgres

# Akun dashboard pertama. Password hanya dipakai saat tabel user masih kosong.
CP_SUPERADMIN_USERNAME=superadmin
CP_SUPERADMIN_DISPLAY_NAME=Super Admin
CP_SUPERADMIN_PASSWORD=SuperAdmin!2026-Meltano
CP_SESSION_HOURS=24

# Secret resolver development. Nilai CP_SECRET_<REF> dibaca worker.
# Untuk production gunakan secret manager, bukan file ini.
CP_SECRET_DEMO=dummy

# Aktifkan hanya untuk uji lokal. Ini menyimpan password koneksi di database
# control plane.
CP_ALLOW_PLAINTEXT_SECRETS=false

# Runtime tuning.
CP_WORKER_CONCURRENCY=2
CP_JOB_TIMEOUT_SECONDS=3600
CP_HEARTBEAT_SECONDS=10
CP_LEASE_SECONDS=300
CP_LOG_TAIL_LINES=100
CP_LOG_LEVEL=info
