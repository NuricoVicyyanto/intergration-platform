# Absolute path to the Meltano project that contains meltano.yml.
# Windows example: C:/Users/User/Documents/devel/my-meltano-project
MELTANO_PROJECT_DIR=C:/Users/User/Documents/devel/my-meltano-project

# Meltano environment and independent job names to run.
MELTANO_ENVIRONMENT=prod
MELTANO_JOBS=job-customers job-orders job-invoices

# Run up to three independent pipelines at a time.
MELTANO_RUN_MANY_WORKERS=3
MELTANO_RUN_MANY_STATE_ID_SUFFIX_TEMPLATE={job}

# Local metadata database. Override this with an external PostgreSQL URI in production.
MELTANO_DATABASE_URI=postgresql+psycopg://meltano:meltano-local@metadata-db:5432/meltano
MELTANO_METADATA_DB_PASSWORD=meltano-local

# Optional image tag and Python version.
MELTANO_WORKER_IMAGE=meltano-workers:local
MELTANO_PYTHON_VERSION=3.13
